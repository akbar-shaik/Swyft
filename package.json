{
  "name": "cloudipa",
  "version": "1.0.0",
  "description": "Cross-platform CLI tool to compile iOS projects into unsigned .ipa packages using GitHub-hosted macOS runners",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cloudipa": "./bin/cloudipa.js"
  },
  "files": [
    "dist",
    "bin",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --target=node18 --outfile=dist/cli.js",
    "start": "node bin/cloudipa.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ios",
    "ipa",
    "github-actions",
    "xcode",
    "cli",
    "cross-platform",
    "unsigned-ipa",
    "sideload"
  ],
  "author": "CloudIPA Authors",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.14",
    "commander": "^12.1.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "cors": "^2.8.6",
    "esbuild": "^0.21.5",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
